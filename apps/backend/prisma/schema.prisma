generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  CATALOG_MANAGER
  VENDEDOR
  DESPACHADOR
  ORDER_MANAGER
}

enum MarketplaceType {
  MERCADO_LIBRE
  SHOPIFY
  WOOCOMMERCE
  JUMPSELLER
  FALABELLA
  PARIS
  HITES
  RIPLEY
  WALMART
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ERROR
}

enum SaleChannel {
  POS
  MERCADO_LIBRE
  SHOPIFY
  WOOCOMMERCE
  JUMPSELLER
  FALABELLA
  PARIS
  HITES
  RIPLEY
  WALMART
  MANUAL
  ORDER_REQUEST
}

enum OrderRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum MovementType {
  SALE
  RETURN
  ADJUSTMENT
  INITIAL
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
}

enum RouteStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopOutcome {
  PENDING
  DELIVERED
  ABSENT
  REFUSED
  RESCHEDULED
  LOST
  RETURNED
}

enum DriverPayModel {
  FLAT
  PER_PACKAGE
}

enum DriverPaymentStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

// Sub-estado de preparación en bodega (vive dentro de OrderStatus.PREPARING).
enum PrepStage {
  UNASSIGNED
  ASSIGNED
  PICKING
  PICKED
  PACKING
  PACKED
}

enum ProfitabilityStatus {
  CONFIRMADO
  DUDOSO
  RECHAZADO
  NO_VERIFICADO
}

enum EmailType {
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY_PICKUP
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  SALE_RECEIPT
}

model Company {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  active                  Boolean  @default(true)
  maxUsers                Int      @default(10)
  modules                 Json?
  mlClientId              String?
  mlClientSecret          String?
  autoSyncSales           Boolean  @default(false)
  autoSyncIntervalMinutes Int      @default(1)
  // Horas límite de despacho por transportista: { "ml_flex": "19:00", ... }
  dispatchCutoffs         Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users              User[]
  products           Product[]
  warehouses         Warehouse[]
  orders             Order[]
  dispatchRoutes     DispatchRoute[]
  connections        MarketplaceConnection[]
  sales              Sale[]
  billingConnections BillingConnection[]
  invoices           Invoice[]
  emailConfig        EmailConfig?
  emailTemplates     EmailTemplate[]
  suppliers          Supplier[]
  purchases          Purchase[]
  stockTransfers     StockTransfer[]
  clients            Client[]
  orderRequests      OrderRequest[]
  billingProfile     BillingProfile?
  profitabilityItems ProfitabilityItem[]
  accessProfiles     AccessProfile[]
  returns            Return[]
  driverPayments     DriverPayment[]

  @@map("companies")
}

// Perfil de acceso: rol con nombre + lista de permisos por página.
// companyId null = plantilla global (solo SUPER_ADMIN). Con companyId = perfil
// propio de esa empresa, gestionable por su COMPANY_ADMIN.
model AccessProfile {
  id          String   @id @default(cuid())
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  users User[]

  @@unique([companyId, name])
  @@map("access_profiles")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  modules Json?

  // Perfil de acceso opcional: si está seteado, define los permisos finos del
  // usuario (por página). Si es null, los permisos se derivan de `role`.
  accessProfileId String?
  accessProfile   AccessProfile? @relation(fields: [accessProfileId], references: [id])

  auditLogs             AuditLog[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  ordersCreated         Order[]          @relation("OrderCreatedBy")
  ordersAssigned        Order[]          @relation("OrderAssignedTo")
  ordersPicked          Order[]          @relation("OrderPickedBy")
  ordersPacked          Order[]          @relation("OrderPackedBy")
  returnsReceived       Return[]         @relation("ReturnReceivedBy")
  driverProfile         DriverProfile?   @relation("UserDriverProfile")
  driverPayments        DriverPayment[]  @relation("DriverPayments")
  driverPaymentsCreated DriverPayment[]  @relation("DriverPaymentCreatedBy")
  itemChecks            OrderItemCheck[] @relation("ItemCheckedBy")
  shipmentPhotos        ShipmentPhoto[]
  dispatchRoutes        DispatchRoute[]  @relation("DispatcherRoutes")
  routesCreated         DispatchRoute[]  @relation("RouteCreatedBy")
  purchases             Purchase[]
  stockTransfers        StockTransfer[]
  orderRequestsCreated  OrderRequest[]   @relation("OrderRequestRequestedBy")
  orderRequestsReviewed OrderRequest[]   @relation("OrderRequestReviewedBy")

  @@map("users")
}

model MarketplaceConnection {
  id                String          @id @default(cuid())
  name              String
  marketplace       MarketplaceType
  mlClientId        String?
  mlClientSecret    String?
  accessToken       String          @default("")
  refreshToken      String?
  expiresAt         DateTime?
  credentials       Json?
  active            Boolean         @default(true)
  lastSalesImportAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  listings Listing[]

  @@map("marketplace_connections")
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  products       Product[]
  orders         Order[]
  purchases      Purchase[]
  purchaseItems  PurchaseItem[]
  productStocks  ProductStock[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  @@map("warehouses")
}

enum ProductType {
  ARTICULO
  SERVICIO
}

model Product {
  id            String      @id @default(cuid())
  sku           String
  name          String
  type          ProductType @default(ARTICULO)
  description   String?     @db.Text
  mlDescription String?     @db.Text
  mlAttributes  Json?
  price         Decimal     @db.Decimal(10, 2)
  mlPrice       Decimal?    @db.Decimal(10, 2)
  cost          Decimal?    @db.Decimal(10, 2)
  stock         Int         @default(0)
  category      String?
  mlCategoryId  String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  images            ProductImage[]
  listings          Listing[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  orderItemChecks   OrderItemCheck[]
  purchaseItems     PurchaseItem[]
  productStocks     ProductStock[]
  stockTransfers    StockTransfer[]
  orderRequestItems OrderRequestItem[]
  returnItems       ReturnItem[]

  @@unique([sku, companyId])
  @@map("products")
}

enum ReturnStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  OPENED
  MISSING_CONTENT
}

// Devolución de un pedido/venta que vuelve a bodega (de cualquier canal).
model Return {
  id           String           @id @default(cuid())
  status       ReturnStatus     @default(PENDING)
  channel      SaleChannel?
  externalId   String? // nº de devolución / reclamo del canal
  reason       String? // motivo declarado por el comprador
  condition    ReturnCondition? // estado al recibir
  notes        String?
  trackingCode String?
  receivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  saleId       String?
  sale         Sale?   @relation(fields: [saleId], references: [id])
  orderId      String?
  order        Order?  @relation(fields: [orderId], references: [id])
  receivedById String?
  receivedBy   User?   @relation("ReturnReceivedBy", fields: [receivedById], references: [id])

  items ReturnItem[]

  @@index([companyId, status])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(cuid())
  productName String
  productSku  String
  quantity    Int
  restocked   Boolean @default(false)

  returnId  String
  return    Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@map("return_items")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  filename  String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Listing {
  id          String        @id @default(cuid())
  externalId  String?
  status      ListingStatus @default(DRAFT)
  externalUrl String?
  syncedAt    DateTime?
  errorMsg    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  productId    String
  product      Product               @relation(fields: [productId], references: [id])
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id])

  @@unique([productId, connectionId])
  @@map("listings")
}

model Sale {
  id              String           @id @default(cuid())
  channel         SaleChannel      @default(POS)
  externalId      String?
  total           Decimal          @db.Decimal(10, 2)
  shippingCost    Decimal?         @db.Decimal(10, 2)
  marketplaceFee  Decimal?         @db.Decimal(10, 2)
  taxes           Decimal?         @db.Decimal(10, 2)
  discount        Decimal?         @db.Decimal(10, 2)
  netAmount       Decimal?         @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  notes           String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  fulfillmentType FulfillmentType?
  shippingMethod  String?
  address         String?
  commune         String?
  city            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  items        SaleItem[]
  invoices     Invoice[]
  order        Order?
  orderRequest OrderRequest?
  returns      Return[]

  @@unique([channel, externalId])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  totalCost Decimal? @db.Decimal(10, 2)

  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  stockMovements StockMovement[]

  @@map("sale_items")
}

model StockMovement {
  id        String       @id @default(cuid())
  type      MovementType
  quantity  Int
  reason    String?
  unitCost  Decimal?     @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  saleItemId     String?
  saleItem       SaleItem?     @relation(fields: [saleItemId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?    @relation(fields: [warehouseId], references: [id])

  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id             String   @id @default(cuid())
  documentNumber String?
  date           DateTime @default(now())
  notes          String?
  total          Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  items PurchaseItem[]

  @@map("purchases")
}

// Cada línea de compra ES un lote de costeo. purchaseId es opcional porque un
// traspaso entre bodegas también genera lotes nuevos en la bodega destino
// (preservando el costo original) sin pertenecer a ninguna Purchase.
model PurchaseItem {
  id                String   @id @default(cuid())
  quantity          Int
  unitCost          Decimal  @db.Decimal(10, 2)
  remainingQuantity Int
  createdAt         DateTime @default(now())

  purchaseId  String?
  purchase    Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  stockMovements StockMovement[]

  @@map("purchase_items")
}

// Stock real por bodega. Product.stock es un total cacheado (suma de estas
// filas), mantenido en la misma transacción, para no romper el código
// existente que ya lee product.stock directo (POS, ML, catálogo).
model ProductStock {
  id        String   @id @default(cuid())
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("product_stock")
}

model StockTransfer {
  id        String   @id @default(cuid())
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  @@map("stock_transfers")
}

model Setting {
  key       String   @id
  value     String   @db.Text
  label     String
  group     String
  hint      String?
  sensitive Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum BillingProvider {
  OPENFACTURA
  FACTO
  BSALE
  DEFONTANA
  NUBOX
  SIIGO
}

enum DteType {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  FACTURA_EXENTA
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PaymentCondition {
  CONTADO
  CREDITO
}

model BillingConnection {
  id          String          @id @default(cuid())
  name        String
  provider    BillingProvider
  credentials Json?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  invoices  Invoice[]

  @@map("billing_connections")
}

model Invoice {
  id          String        @id @default(cuid())
  folio       Int?
  dteType     DteType
  rut         String
  razonSocial String
  giro        String?
  address     String?
  commune     String?
  email       String?
  netAmount   Decimal       @db.Decimal(12, 2)
  tax         Decimal       @db.Decimal(12, 2)
  totalAmount Decimal       @db.Decimal(12, 2)
  items       Json
  notes       String?
  status      InvoiceStatus @default(DRAFT)
  pdfUrl      String?
  xmlUrl      String?
  externalId  String?
  issuedAt    DateTime?
  errorMsg    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  paid             Boolean           @default(false)
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  paymentReference String?
  paymentCondition PaymentCondition?
  dueDate          DateTime?

  connectionId String
  connection   BillingConnection @relation(fields: [connectionId], references: [id])
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id])
  saleId       String?
  sale         Sale?             @relation(fields: [saleId], references: [id])
  clientId     String?
  client       Client?           @relation(fields: [clientId], references: [id])

  @@map("invoices")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  rut         String?
  giro        String?
  email       String?
  phone       String?
  address     String?
  commune     String?
  city        String?
  creditLimit Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  orderRequests OrderRequest[]
  invoices      Invoice[]

  @@map("clients")
}

model OrderRequest {
  id                    String             @id @default(cuid())
  status                OrderRequestStatus @default(PENDING)
  scheduledDispatchDate DateTime?
  notes                 String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id])
  requestedById String
  requestedBy   User    @relation("OrderRequestRequestedBy", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?   @relation("OrderRequestReviewedBy", fields: [reviewedById], references: [id])
  saleId        String? @unique
  sale          Sale?   @relation(fields: [saleId], references: [id])

  items OrderRequestItem[]

  @@map("order_requests")
}

model OrderRequestItem {
  id        String   @id @default(cuid())
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  orderRequestId String
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])

  @@map("order_request_items")
}

model PlatformSetting {
  id          String   @id @default(cuid())
  platform    String   @unique
  displayName String?
  description String?
  logoUrl     String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model Order {
  id              String          @id @default(cuid())
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType @default(DELIVERY)
  notes           String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  address         String?
  commune         String?
  city            String?
  region          String?
  courier         String?
  trackingCode    String?
  scheduledDate   DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Flujo de bodega (asignación → picking → packing)
  prepStage    PrepStage @default(UNASSIGNED)
  assignedAt   DateTime?
  pickedAt     DateTime?
  packedAt     DateTime?
  dispatchedAt DateTime?
  assignedToId String?
  assignedTo   User?     @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  pickedById   String?
  pickedBy     User?     @relation("OrderPickedBy", fields: [pickedById], references: [id])
  packedById   String?
  packedBy     User?     @relation("OrderPackedBy", fields: [packedById], references: [id])

  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  saleId      String?    @unique
  sale        Sale?      @relation(fields: [saleId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdById String?
  createdBy   User?      @relation("OrderCreatedBy", fields: [createdById], references: [id])

  itemChecks OrderItemCheck[]
  returns    Return[]

  @@index([companyId, status, prepStage])
  photos     ShipmentPhoto[]
  routeStop  RouteStop?

  @@map("orders")
}

model OrderItemCheck {
  id          String    @id @default(cuid())
  productName String
  productSku  String
  expectedQty Int
  checkedQty  Int?
  checked     Boolean   @default(false)
  outOfStock  Boolean   @default(false)
  notes       String?
  checkedAt   DateTime?

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  checkedById String?
  checkedBy   User?    @relation("ItemCheckedBy", fields: [checkedById], references: [id])

  @@map("order_item_checks")
}

model ShipmentPhoto {
  id        String   @id @default(cuid())
  url       String
  filename  String
  notes     String?
  createdAt DateTime @default(now())

  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  @@map("shipment_photos")
}

model DispatchRoute {
  id          String      @id @default(cuid())
  name        String
  date        DateTime    @db.Date
  status      RouteStatus @default(PENDING)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  dispatcherId String?
  dispatcher   User?   @relation("DispatcherRoutes", fields: [dispatcherId], references: [id])
  createdById  String?
  createdBy    User?   @relation("RouteCreatedBy", fields: [createdById], references: [id])

  stops RouteStop[]

  @@map("dispatch_routes")
}

model RouteStop {
  id           String      @id @default(cuid())
  position     Int
  notes        String?
  lat          Float?
  lng          Float?
  outcome      StopOutcome @default(PENDING)
  attemptedAt  DateTime?
  deliveredAt  DateTime?
  deliveredLat Float?
  deliveredLng Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  routeId String
  route   DispatchRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId String        @unique
  order   Order         @relation(fields: [orderId], references: [id])

  driverPaymentId String?
  driverPayment   DriverPayment? @relation(fields: [driverPaymentId], references: [id])

  @@map("route_stops")
}

// Ficha del repartidor (1:1 con un User de rol DESPACHADOR).
model DriverProfile {
  id             String         @id @default(cuid())
  phone          String?
  address        String?
  zone           String?
  notes          String?
  payModel       DriverPayModel @default(FLAT)
  flatRate       Decimal        @default(0) @db.Decimal(10, 2)
  perPackageRate Decimal        @default(0) @db.Decimal(10, 2)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId String @unique
  user   User   @relation("UserDriverProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

// Lote de pago a un repartidor por paquetes entregados en un rango.
model DriverPayment {
  id        String              @id @default(cuid())
  periodFrom DateTime
  periodTo   DateTime
  packages  Int
  amount    Decimal             @db.Decimal(12, 2)
  status    DriverPaymentStatus @default(PENDING)
  paidAt    DateTime?
  notes     String?
  createdAt DateTime            @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  driverId  String
  driver    User    @relation("DriverPayments", fields: [driverId], references: [id])
  createdById String?
  createdBy   User?  @relation("DriverPaymentCreatedBy", fields: [createdById], references: [id])

  stops RouteStop[]

  @@index([companyId, driverId, status])
  @@map("driver_payments")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model EmailConfig {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String
  pass      String
  fromName  String
  fromEmail String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_configs")
}

model EmailTemplate {
  id        String    @id @default(cuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      EmailType
  subject   String
  bodyHtml  String    @db.Text
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, type])
  @@map("email_templates")
}

// Identidad de la empresa como emisora de documentos tributarios (DTE): se usa
// como fuente única de estos datos al emitir, en vez de repetirlos por conexión.
model BillingProfile {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  razonSocial      String?
  rut              String?
  giro             String?
  address          String?
  commune          String?
  city             String?
  phone            String?
  email            String?
  logoUrl          String?
  resolutionNumber String?
  resolutionDate   DateTime?
  footerText       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("billing_profiles")
}

// Comparador de rentabilidad: costo propio vs. precio de venta de la competencia,
// para decidir qué productos subir/publicitar. myPrice/manualPrice implementan la
// regla "mi precio = precio competencia - 1000, salvo que lo haya fijado a mano":
// myPrice queda null mientras siga la sugerencia automática; se guarda un valor
// solo cuando el usuario lo edita directamente (manualPrice = true).
model ProfitabilityItem {
  id                    String              @id @default(cuid())
  name                  String
  cost                  Decimal             @db.Decimal(10, 2)
  competitorName        String?
  competitorPrice       Decimal?            @db.Decimal(10, 2)
  competitorUrl         String?
  myDimensions          String?
  competitorDimensions  String?
  status                ProfitabilityStatus @default(NO_VERIFICADO)
  note                  String?
  myPrice               Decimal?            @db.Decimal(10, 2)
  manualPrice           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@map("profitability_items")
}
