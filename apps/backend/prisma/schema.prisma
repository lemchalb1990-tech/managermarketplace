  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  razonSocial      String?
  rut              String?
  giro             String?
  address          String?
  commune          String?
  city             String?
  phone            String?
  email            String?
  logoUrl          String?
  resolutionNumber String?
  resolutionDate   DateTime?
  footerText       String?
