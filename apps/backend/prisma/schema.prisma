enum WorkOrderStatus {
  PENDING   // Editable, sin cobrar, no descuenta stock. Se imprime y se entrega al cliente.
  CONVERTED // El cliente aceptó: se cobró y quedó como venta (Sale) — recién ahí se descuenta stock.
  REJECTED  // El cliente no aceptó el presupuesto.
  CANCELLED // Anulada por el local antes de presentarla o de tener respuesta del cliente.
}

// Presupuesto/orden de trabajo del POS: se arma con productos del catálogo y/o líneas
// libres (p.ej. mano de obra), se imprime para el cliente, y NO afecta el stock ni genera
// cobro hasta que el cliente la acepta (ver WorkOrdersService.convertToSale). Mientras esté
// PENDING se puede seguir editando; al convertirse queda fija, igual que cualquier venta.
model WorkOrder {
  id            String          @id @default(cuid())
  // Correlativo simple por empresa (no es un folio tributario) para poder referenciar la
  // orden en el mostrador aunque no tenga cliente asociado.
  folio         Int
  status        WorkOrderStatus @default(PENDING)
  notes         String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  convertedAt   DateTime?
  closedAt      DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  saleId    String? @unique
  sale      Sale?   @relation(fields: [saleId], references: [id])

  items WorkOrderItem[]

  @@unique([companyId, folio])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String  @id @default(cuid())
  // Snapshot al momento de agregar la línea (igual criterio que ReturnItem/OrderItemCheck):
  // si es un producto del catálogo, se copia su nombre/SKU; si es una línea libre (p.ej.
  // "Mano de obra: diagnóstico"), productId queda null y este es el único registro del cargo.
  productName String
  productSku  String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  // Bodega contra la que se reservó esta línea (fase 3) — se guarda acá, no se relee de
  // Product.warehouseId al liberar, para que un cambio posterior de bodega por defecto del
  // producto no libere la reserva en una bodega distinta a la que realmente se comprometió.
  reservedWarehouseId String?
  reservedWarehouse   Warehouse? @relation(fields: [reservedWarehouseId], references: [id])

  @@map("work_order_items")
}

model PlatformSetting {
