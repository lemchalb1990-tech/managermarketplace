  updatedAt        DateTime  @updatedAt

  @@map("billing_profiles")
}

// Comparador de rentabilidad: costo propio vs. precio de venta de la competencia,
// para decidir qué productos subir/publicitar. myPrice/manualPrice implementan la
// regla "mi precio = precio competencia - 1000, salvo que lo haya fijado a mano":
// myPrice queda null mientras siga la sugerencia automática; se guarda un valor
// solo cuando el usuario lo edita directamente (manualPrice = true).
model ProfitabilityItem {
  id                    String              @id @default(cuid())
  name                  String
  cost                  Decimal             @db.Decimal(10, 2)
  competitorName        String?
  competitorPrice       Decimal?            @db.Decimal(10, 2)
  competitorUrl         String?
  myDimensions          String?
  competitorDimensions  String?
  status                ProfitabilityStatus @default(NO_VERIFICADO)
  note                  String?
  myPrice               Decimal?            @db.Decimal(10, 2)
  manualPrice           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@map("profitability_items")
}

// ─── Dropshipping ────────────────────────────────────────────────────────────
// La empresa vende productos que no tiene en stock: un proveedor externo los
// despacha directo al cliente final. Al entrar una venta con productos dropship
// se genera un DropshipOrder por proveedor (auto o manual), que se envía al
// proveedor y se sigue hasta la entrega. El stock propio nunca se toca.

enum DropshipOrderStatus {
  PENDING // detectado desde la venta, aún no enviado al proveedor
  SENT // enviado al proveedor (email / exportación)
  CONFIRMED // proveedor confirmó el pedido
  SHIPPED // proveedor despachó (con tracking)
  DELIVERED // entregado al cliente final
  CANCELLED
}

model DropshipSupplier {
  id               String   @id @default(cuid())
  active           Boolean  @default(true)
  // Automatización: generar el pedido al proveedor apenas entra la venta.
  autoCreateOrders Boolean  @default(true)
  leadTimeDays     Int? // días estimados de despacho del proveedor
  notes            String?
  // Feed del catálogo del proveedor (CSV o JSON) para sincronizar productos.
  catalogUrl       String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  products DropshipProduct[]
  orders   DropshipOrder[]

  @@map("dropship_suppliers")
}

model DropshipProduct {
  id           String   @id @default(cuid())
  supplierSku  String?
  supplierCost Decimal  @db.Decimal(10, 2) // precio que cobra el proveedor (≠ precio de venta)
  leadTimeDays Int?
  active       Boolean  @default(true)
  // Datos del producto según el proveedor (sincronizados desde su catálogo/feed).
  supplierName        String?
  supplierImageUrl    String?
  supplierDescription String?   @db.Text
  supplierStock       Int?
  lastSyncedAt        DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  dropshipSupplierId String
  dropshipSupplier   DropshipSupplier @relation(fields: [dropshipSupplierId], references: [id], onDelete: Cascade)
  productId          String           @unique // v1: un producto pertenece a un solo proveedor dropship
  product            Product          @relation(fields: [productId], references: [id])

  @@map("dropship_products")
}

model DropshipOrder {
  id           String              @id @default(cuid())
  status       DropshipOrderStatus @default(PENDING)
  supplierCost Decimal             @db.Decimal(10, 2) // suma del costo proveedor
  saleAmount   Decimal             @db.Decimal(10, 2) // suma del precio de venta de los ítems dropship
  channelFee   Decimal?            @db.Decimal(10, 2) // comisión del canal prorrateada
  trackingCode String?
  courier      String?
  supplierRef  String? // nº de pedido / confirmación del proveedor
  notes        String?
  sentAt       DateTime?
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  dropshipSupplierId String
  dropshipSupplier   DropshipSupplier @relation(fields: [dropshipSupplierId], references: [id])
  saleId             String
  sale               Sale             @relation(fields: [saleId], references: [id])

  items DropshipOrderItem[]

  @@unique([saleId, dropshipSupplierId]) // una venta genera un único pedido por proveedor
  @@index([companyId, status])
  @@map("dropship_orders")
}

model DropshipOrderItem {
  id          String  @id @default(cuid())
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2) // precio de venta unitario
  unitCost    Decimal @db.Decimal(10, 2) // costo proveedor unitario

  dropshipOrderId String
  dropshipOrder   DropshipOrder @relation(fields: [dropshipOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  saleItemId      String?
  saleItem        SaleItem?     @relation(fields: [saleItemId], references: [id])

  @@map("dropship_order_items")
}
