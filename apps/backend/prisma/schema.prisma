  // Flujo de bodega (asignación → picking → packing)
  prepStage    PrepStage @default(UNASSIGNED)
  assignedAt   DateTime?
  pickedAt     DateTime?
  packedAt     DateTime?
  dispatchedAt DateTime?
  assignedToId String?
  assignedTo   User?     @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  pickedById   String?
  pickedBy     User?     @relation("OrderPickedBy", fields: [pickedById], references: [id])
  packedById   String?
  packedBy     User?     @relation("OrderPackedBy", fields: [packedById], references: [id])

  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  saleId      String?    @unique
  sale        Sale?      @relation(fields: [saleId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdById String?
  createdBy   User?      @relation("OrderCreatedBy", fields: [createdById], references: [id])

  itemChecks OrderItemCheck[]
