generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  CATALOG_MANAGER
  VENDEDOR
  DESPACHADOR
  ORDER_MANAGER
}

enum MarketplaceType {
  MERCADO_LIBRE
  SHOPIFY
  WOOCOMMERCE
  JUMPSELLER
  FALABELLA
  PARIS
  HITES
  RIPLEY
  WALMART
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ERROR
}

enum SaleChannel {
  POS
  MERCADO_LIBRE
  SHOPIFY
  WOOCOMMERCE
  JUMPSELLER
  FALABELLA
  PARIS
  HITES
  RIPLEY
  WALMART
  MANUAL
  ORDER_REQUEST
}

enum OrderRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum MovementType {
  SALE
  RETURN
  ADJUSTMENT
  INITIAL
  PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
}

enum RouteStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopOutcome {
  PENDING
  DELIVERED
  ABSENT
  REFUSED
  RESCHEDULED
  LOST
  RETURNED
}

enum DriverPayModel {
  FLAT
  PER_PACKAGE
}

enum DriverPaymentStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

// Sub-estado de preparación en bodega (vive dentro de OrderStatus.PREPARING).
enum PrepStage {
  UNASSIGNED
  ASSIGNED
  PICKING
  PICKED
  PACKING
  PACKED
}

enum ProfitabilityStatus {
  CONFIRMADO
  DUDOSO
  RECHAZADO
  NO_VERIFICADO
}

enum EmailType {
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY_PICKUP
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  SALE_RECEIPT
}

model Company {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  active                  Boolean  @default(true)
  maxUsers                Int      @default(10)
  modules                 Json?
  mlClientId              String?
  mlClientSecret          String?
  autoSyncSales           Boolean  @default(false)
  // Plataformas con auto-importación de ventas activa (array de MarketplaceType).
  // null/[] = ninguna. Reemplaza al flag global autoSyncSales.
  autoSyncSalesPlatforms  Json?
  autoSyncIntervalMinutes Int      @default(1)
  // Horas límite de despacho por transportista: { "ml_flex": "19:00", ... }
  dispatchCutoffs         Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users              User[]
  products           Product[]
  warehouses         Warehouse[]
  orders             Order[]
  dispatchRoutes     DispatchRoute[]
  connections        MarketplaceConnection[]
  sales              Sale[]
  billingConnections BillingConnection[]
  invoices           Invoice[]
  emailConfig        EmailConfig?
  emailTemplates     EmailTemplate[]
  suppliers          Supplier[]
  purchases          Purchase[]
  stockTransfers     StockTransfer[]
  clients            Client[]
  orderRequests      OrderRequest[]
  workOrders         WorkOrder[]
  billingProfile     BillingProfile?
  profitabilityItems ProfitabilityItem[]
  accessProfiles     AccessProfile[]
  returns            Return[]
  driverPayments     DriverPayment[]
  dropshipSuppliers  DropshipSupplier[]
  dropshipProducts   DropshipProduct[]
  dropshipOrders     DropshipOrder[]
  mlQuestions        MlQuestion[]
  mlClaims           MlClaim[]
  productMasters     ProductMaster[]
  categories         Category[]

  @@map("companies")
}

// Perfil de acceso: rol con nombre + lista de permisos por página.
// companyId null = plantilla global (solo SUPER_ADMIN). Con companyId = perfil
// propio de esa empresa, gestionable por su COMPANY_ADMIN.
model AccessProfile {
  id          String   @id @default(cuid())
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  users User[]

  @@unique([companyId, name])
  @@map("access_profiles")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  modules Json?

  // Perfil de acceso opcional: si está seteado, define los permisos finos del
  // usuario (por página). Si es null, los permisos se derivan de `role`.
  accessProfileId String?
  accessProfile   AccessProfile? @relation(fields: [accessProfileId], references: [id])

  auditLogs             AuditLog[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  ordersCreated         Order[]          @relation("OrderCreatedBy")
  ordersAssigned        Order[]          @relation("OrderAssignedTo")
  ordersPicked          Order[]          @relation("OrderPickedBy")
  ordersPacked          Order[]          @relation("OrderPackedBy")
  returnsReceived       Return[]         @relation("ReturnReceivedBy")
  driverProfile         DriverProfile?   @relation("UserDriverProfile")
  driverPayments        DriverPayment[]  @relation("DriverPayments")
  driverPaymentsCreated DriverPayment[]  @relation("DriverPaymentCreatedBy")
  itemChecks            OrderItemCheck[] @relation("ItemCheckedBy")
  shipmentPhotos        ShipmentPhoto[]
  dispatchRoutes        DispatchRoute[]  @relation("DispatcherRoutes")
  routesCreated         DispatchRoute[]  @relation("RouteCreatedBy")
  purchases             Purchase[]
  stockTransfers        StockTransfer[]
  orderRequestsCreated  OrderRequest[]   @relation("OrderRequestRequestedBy")
  orderRequestsReviewed OrderRequest[]   @relation("OrderRequestReviewedBy")
  workOrders            WorkOrder[]

  @@map("users")
}

model MarketplaceConnection {
  id                String          @id @default(cuid())
  name              String
  marketplace       MarketplaceType
  mlClientId        String?
  mlClientSecret    String?
  accessToken       String          @default("")
  refreshToken      String?
  expiresAt         DateTime?
  credentials       Json?
  active            Boolean         @default(true)
  lastSalesImportAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  listings   Listing[]
  sales      Sale[]
  mlQuestions MlQuestion[]
  mlClaims    MlClaim[]
  channelPrices  ChannelPrice[]
  syncQueueItems SyncQueueItem[]

  @@map("marketplace_connections")
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  products       Product[]
  orders         Order[]
  purchases      Purchase[]
  purchaseItems  PurchaseItem[]
  productStocks  ProductStock[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  workOrderItems WorkOrderItem[]

  @@map("warehouses")
}

enum ProductType {
  ARTICULO
  SERVICIO
}

model Product {
  id            String      @id @default(cuid())
  sku           String
  name          String
  type          ProductType @default(ARTICULO)
  description   String?     @db.Text
  mlDescription String?     @db.Text
  mlAttributes  Json?
  // "family_name" de Mercado Libre (modelo "Precio por Variación"/User Products): se usa
  // en vez de title al publicar si la cuenta lo exige (ver publishProduct). Se completa
  // automáticamente al importar una publicación que ya lo tenía.
  mlFamilyName  String?
  price         Decimal     @db.Decimal(10, 2)
  mlPrice       Decimal?    @db.Decimal(10, 2)
  cost          Decimal?    @db.Decimal(10, 2)
  // Precio que cobra el proveedor dropship (≠ precio de venta). Solo se usa/edita
  // cuando la empresa tiene el módulo de dropshipping activo.
  supplierPrice Decimal?    @db.Decimal(10, 2)
  // Fase 7 (motor de precios): precio mayorista, aparte del precio de venta normal.
  wholesalePrice Decimal?   @db.Decimal(10, 2)
  stock         Int         @default(0)
  // Umbral de stock crítico: al alcanzarlo (o bajarlo) las ventas pausan la publicación.
  criticalStock Int         @default(0)
  category      String?
  mlCategoryId  String?
  active        Boolean     @default(true)
  // Producto fulfilleado por un proveedor dropship: no descuenta stock propio en las ventas.
  dropship      Boolean     @default(false)
  // Dimensiones y peso del paquete de envío (opcional). Mercado Libre las exige como
  // atributos SELLER_PACKAGE_* en categorías sin dato de paquete propio del catálogo; si
  // quedan vacías, se manda un valor genérico de respaldo al publicar (ver publishProduct).
  packageHeight Decimal?    @db.Decimal(8, 2) // cm
  packageWidth  Decimal?    @db.Decimal(8, 2) // cm
  packageLength Decimal?    @db.Decimal(8, 2) // cm
  packageWeight Decimal?    @db.Decimal(8, 2) // g
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  // Producto Maestro al que pertenece (fase 1 de la reorganización de catálogo). Opcional
  // a propósito: ligar los 4.139 productos existentes es una migración aparte (fase 10),
  // no algo que este campo fuerce por sí solo.
  productMasterId String?
  productMaster   ProductMaster? @relation(fields: [productMasterId], references: [id])

  images             ProductImage[]
  listings           Listing[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  orderItemChecks    OrderItemCheck[]
  purchaseItems      PurchaseItem[]
  productStocks      ProductStock[]
  stockTransfers     StockTransfer[]
  orderRequestItems  OrderRequestItem[]
  returnItems        ReturnItem[]
  dropshipProduct    DropshipProduct?
  dropshipOrderItems DropshipOrderItem[]
  workOrderItems     WorkOrderItem[]
  mlQuestions        MlQuestion[]
  variantAttributes  VariantAttribute[]
  channelPrices      ChannelPrice[]
  syncQueueItems     SyncQueueItem[]

  @@unique([sku, companyId])
  @@map("products")
}

enum ProductMasterStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// Fase 1 de la reorganización de catálogo (ver auditoría): el "padre comercial" que
// agrupa las variantes de un mismo producto real. Convive con Product sin reemplazarlo
// todavía — Product.productMasterId es opcional y nada lo autocompleta hoy. Las fases
// siguientes agregan Variant (SKU vendible real), Inventario por variante/bodega y
// Publicación por canal; esta fase solo deja la entidad y el enganche listos.
model ProductMaster {
  id        String              @id @default(cuid())
  masterSku String
  name      String
  brand     String?
  model     String?
  type      ProductType         @default(ARTICULO)
  status    ProductMasterStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Fase 5: taxonomía propia (antes era un string suelto, "internalCategory" — se
  // reemplaza por un árbol real antes de que nada lo usara todavía).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  products Product[]
  // Fase 6: contenido/SEO maestro (1 a 1) y overrides por canal (1 a N).
  content        ProductContent?
  channelContent ChannelContent[]
  images         ProductMasterImage[]

  @@unique([masterSku, companyId])
  @@map("product_masters")
}

// Fase 5: taxonomía interna propia (Automóvil → Seguridad → Sensores de retroceso),
// independiente de la categoría que cada canal use — la relación con la categoría de
// Mercado Libre/Jumpseller/etc. vive en CategoryChannelMapping, no mezclada acá.
model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  productMasters  ProductMaster[]
  channelMappings CategoryChannelMapping[]

  @@unique([companyId, parentId, name])
  @@map("categories")
}

// A qué categoría de cada canal corresponde una categoría interna — "platform" usa el
// mismo formato de clave que PlatformSetting.platform (ej. "mercadolibre", "jumpseller").
model CategoryChannelMapping {
  id                   String  @id @default(cuid())
  platform             String
  externalCategoryId   String
  externalCategoryName String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, platform])
  @@map("category_channel_mappings")
}

enum ContentMode {
  AUTO
  CUSTOM
}

// Fase 6: contenido/SEO del Producto Maestro. titleMode/descriptionMode en CUSTOM
// significa "esto lo editó una persona, no lo pise un cambio automático del maestro".
model ProductContent {
  id              String      @id @default(cuid())
  seoTitle        String?
  h1              String?
  slug            String?
  metaDescription String?     @db.Text
  keywords        String?
  description     String?     @db.Text
  features        Json?
  specifications  Json?
  compatibility   Json?
  titleMode       ContentMode @default(AUTO)
  descriptionMode ContentMode @default(AUTO)
  updatedAt       DateTime    @updatedAt

  productMasterId String        @unique
  productMaster   ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  @@map("product_content")
}

// Override de título/descripción para un canal puntual (ej. "Título ALTIRO" distinto del
// "Título Mercado Libre"). Ausente = se usa el contenido maestro tal cual.
model ChannelContent {
  id          String      @id @default(cuid())
  platform    String
  title       String?
  description String?     @db.Text
  mode        ContentMode @default(AUTO)
  updatedAt   DateTime    @updatedAt

  productMasterId String
  productMaster   ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  @@unique([productMasterId, platform])
  @@map("channel_content")
}

// Fotos generales del Producto Maestro (ej. foto de familia con las 4 variantes juntas).
// Las fotos propias de cada variante siguen siendo ProductImage, en Product.
model ProductMasterImage {
  id        String   @id @default(cuid())
  url       String
  filename  String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  productMasterId String
  productMaster   ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  @@map("product_master_images")
}

// Fase 7: precio de este producto (variante) en una cuenta/conexión puntual — permite que
// "Altiro Nuevo" y "Merca todo" (dos cuentas de Mercado Libre) tengan precios distintos
// para el mismo producto, algo que Product.mlPrice (un solo valor) no podía expresar.
// Ausente = se sigue usando mlPrice/price como hasta ahora (fallback, sin romper nada).
model ChannelPrice {
  id        String   @id @default(cuid())
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId    String
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([productId, connectionId])
  @@map("channel_prices")
}

enum SyncQueueField {
  STOCK
  PRICE
  TITLE
  IMAGES
  DESCRIPTION
  CATEGORY
  ATTRIBUTES
}

enum SyncQueueStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Fase 8: motor de sincronización con reintentos y trazabilidad. Stock/Precio se procesan
// solos (igual regla "inmediata"/"automática controlada" del plan); Título/Imágenes/
// Descripción/Categoría/Atributos quedan en PENDING para revisión manual — nunca se
// autopublican, tal cual la regla "🛡️ Validar" del plan de sincronización.
model SyncQueueItem {
  id          String          @id @default(cuid())
  field       SyncQueueField
  status      SyncQueueStatus @default(PENDING)
  payload     Json?
  attempts    Int             @default(0)
  lastError   String?
  createdAt   DateTime        @default(now())
  processedAt DateTime?

  productId    String
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("sync_queue_items")
}

// Fase 2: lo que distingue a un Product cuando actúa como variante vendible de un
// Producto Maestro (ej. name="Color", value="Negro"). El SKU vendible sigue siendo
// Product.sku — no se duplica campo de stock/precio acá, esos ya viven en Product y en
// la fase 3 (Inventario Central) se les da tratamiento por bodega. El variation_id de
// Mercado Libre por canal es fase 4 (ChannelListingVariant), no esto.
model VariantAttribute {
  id    String @id @default(cuid())
  name  String
  value String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("variant_attributes")
}

enum ReturnStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  OPENED
  MISSING_CONTENT
}

// Devolución de un pedido/venta que vuelve a bodega (de cualquier canal).
model Return {
  id           String           @id @default(cuid())
  status       ReturnStatus     @default(PENDING)
  channel      SaleChannel?
  externalId   String? // nº de devolución / reclamo del canal
  reason       String? // motivo declarado por el comprador
  condition    ReturnCondition? // estado al recibir
  notes        String?
  trackingCode String?
  receivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  companyId    String
  company      Company @relation(fields: [companyId], references: [id])
  saleId       String?
  sale         Sale?   @relation(fields: [saleId], references: [id])
  orderId      String?
  order        Order?  @relation(fields: [orderId], references: [id])
  receivedById String?
  receivedBy   User?   @relation("ReturnReceivedBy", fields: [receivedById], references: [id])

  items ReturnItem[]

  @@index([companyId, status])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(cuid())
  productName String
  productSku  String
  quantity    Int
  restocked   Boolean @default(false)

  returnId  String
  return    Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@map("return_items")
}

enum SaleFeedbackRating {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum MlQuestionStatus {
  UNANSWERED
  ANSWERED
  CLOSED_UNANSWERED
  UNDER_REVIEW
  BANNED
  DELETED
  DISABLED
}

// Pregunta hecha por un comprador sobre una publicación de Mercado Libre (antes de
// comprar). Se sincroniza vía webhook (tópico "questions") y se responde desde acá.
model MlQuestion {
  id            String           @id @default(cuid())
  externalId    String           @unique // id de la pregunta en ML
  itemId        String // id del ítem de ML (MLC...)
  itemTitle     String?
  itemThumbnail String?
  text          String           @db.Text
  status        MlQuestionStatus @default(UNANSWERED)
  answerText    String?          @db.Text
  answeredAt    DateTime?
  fromNickname  String?
  dateCreated   DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  companyId    String
  company      Company               @relation(fields: [companyId], references: [id])
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id])
  productId    String?
  product      Product?              @relation(fields: [productId], references: [id])

  @@index([companyId, status])
  @@map("ml_questions")
}

enum MlClaimStatus {
  OPENED
  CLOSED
}

// Reclamo/disputa/devolución iniciada por el comprador tras la compra (API de
// post-purchase de Mercado Libre). Las de tipo "return"/"dispute" además generan
// una fila en Return para que, al recibir el paquete, se reponga el stock.
model MlClaim {
  id              String        @id @default(cuid())
  externalId      String        @unique // id del reclamo en ML
  type            String // mediations, cancel_sale, cancel_sale_by_iron, return, dispute, fraud, etc.
  status          MlClaimStatus @default(OPENED)
  stage           String?
  reason          String?
  orderExternalId String?
  lastSyncedAt    DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  companyId    String
  company      Company               @relation(fields: [companyId], references: [id])
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id])
  saleId       String?
  sale         Sale?                 @relation(fields: [saleId], references: [id])

  @@index([companyId, status])
  @@map("ml_claims")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  filename  String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Listing {
  id          String        @id @default(cuid())
  externalId  String?
  status      ListingStatus @default(DRAFT)
  externalUrl String?
  syncedAt    DateTime?
  errorMsg    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Fase 4 (publicación por canal, ver auditoría): cuando varios Product-variante de un
  // mismo Producto Maestro se publican como UNA sola publicación de Mercado Libre con
  // variaciones nativas, externalId es el mismo ítem de ML para todos y variationId
  // distingue cuál variación (color/talla) le corresponde a cada uno. Null = publicación
  // simple, sin variaciones (el caso de hoy).
  variationId String?

  productId    String
  product      Product               @relation(fields: [productId], references: [id])
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id])

  @@unique([productId, connectionId])
  @@map("listings")
}

model Sale {
  id              String           @id @default(cuid())
  channel         SaleChannel      @default(POS)
  externalId      String?
  total           Decimal          @db.Decimal(10, 2)
  shippingCost    Decimal?         @db.Decimal(10, 2)
  marketplaceFee  Decimal?         @db.Decimal(10, 2)
  taxes           Decimal?         @db.Decimal(10, 2)
  discount        Decimal?         @db.Decimal(10, 2)
  netAmount       Decimal?         @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  notes           String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  fulfillmentType FulfillmentType?
  shippingMethod  String?
  address         String?
  commune         String?
  city            String?
  // Calificación que el comprador dejó tras la compra (feedback de Mercado Libre:
  // positiva/neutra/negativa + comentario). Solo aplica a canales que lo soporten.
  mlFeedbackRating  SaleFeedbackRating?
  mlFeedbackComment String?             @db.Text
  mlFeedbackAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id])
  // Cuenta/conexión de marketplace que originó la venta (null en POS o ventas manuales).
  // Permite distinguir de qué cuenta vino la venta cuando una empresa tiene varias
  // conexiones del mismo canal (p.ej. dos cuentas de Mercado Libre).
  connectionId String?
  connection   MarketplaceConnection? @relation(fields: [connectionId], references: [id])

  items         SaleItem[]
  invoices      Invoice[]
  order         Order?
  orderRequest  OrderRequest?
  returns       Return[]
  dropshipOrders DropshipOrder[]
  workOrder     WorkOrder?
  mlClaims      MlClaim[]

  @@unique([channel, externalId])
  @@map("sales")
}

model SaleItem {
